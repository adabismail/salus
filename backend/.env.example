# Copy to .env to enable non-default behaviour. All optional — Salus runs fully without any of these.

# "simulate" (default) or "live" (calls Razorpay test-mode APIs)
SALUS_MODE=simulate

# Reproducible batch + outcomes. Change to reshuffle the synthetic batch.
SALUS_SEED=7
SALUS_BATCH_SIZE=52

# Razorpay TEST-MODE keys (rzp_test_...). Required only when SALUS_MODE=live.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Anthropic key — enables Claude-refined Hinglish/English recovery copy. Falls back silently if unset.
ANTHROPIC_API_KEY=
SALUS_LLM_MODEL=claude-sonnet-5
